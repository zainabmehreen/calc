<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Calculator</title>
<style>
  :root {
    --bg: #e9ecef;
    --body: #1f2a37;
    --screen: #c9d6c3;
    --ink: #1b241a;
    --key: #f4f5f7;
    --key-text: #1f2a37;
    --op: #3a4a5e;
    --op-text: #ffffff;
    --accent: #e5533d;
    --accent-text: #ffffff;
    --focus: #2f7cf6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
  }
  .calc {
    width: min(92vw, 340px);
    background: var(--body);
    padding: 18px;
    border-radius: 20px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .25);
  }
  .screen {
    background: var(--screen);
    color: var(--ink);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 16px;
    text-align: right;
    font-family: "Courier New", ui-monospace, monospace;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .history { font-size: 14px; opacity: .65; min-height: 20px; word-break: break-all; }
  .current { font-size: 38px; font-weight: 700; line-height: 1.2; word-break: break-all; }
  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  button {
    font: inherit;
    font-size: 20px;
    font-weight: 600;
    padding: 16px 0;
    border: 0;
    border-radius: 12px;
    background: var(--key);
    color: var(--key-text);
    cursor: pointer;
    box-shadow: 0 3px 0 rgba(0, 0, 0, .25);
    transition: transform .06s, box-shadow .06s;
  }
  button:active { transform: translateY(3px); box-shadow: none; }
  button:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .op { background: var(--op); color: var(--op-text); }
  .clear { background: var(--accent); color: var(--accent-text); }
  .equals { background: var(--accent); color: var(--accent-text); grid-row: span 2; }
  .zero { grid-column: span 2; }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
</head>
<body>
  <main class="calc" aria-label="Calculator">
    <div class="screen" aria-live="polite">
      <div class="history" id="history"></div>
      <div class="current" id="current">0</div>
    </div>
    <div class="keys">
      <button class="clear" data-action="clear">AC</button>
      <button class="op" data-action="delete" aria-label="Delete">&#9003;</button>
      <button class="op" data-action="percent">%</button>
      <button class="op" data-op="÷">÷</button>

      <button data-num="7">7</button>
      <button data-num="8">8</button>
      <button data-num="9">9</button>
      <button class="op" data-op="×">×</button>

      <button data-num="4">4</button>
      <button data-num="5">5</button>
      <button data-num="6">6</button>
      <button class="op" data-op="−">−</button>

      <button data-num="1">1</button>
      <button data-num="2">2</button>
      <button data-num="3">3</button>
      <button class="op" data-op="+">+</button>

      <button class="zero" data-num="0">0</button>
      <button data-action="dot">.</button>
      <button class="equals" data-action="equals">=</button>
    </div>
  </main>

<script>
  const currentEl = document.getElementById("current");
  const historyEl = document.getElementById("history");

  let current = "0";     // number being typed
  let previous = null;   // stored left operand
  let operator = null;   // pending operator
  let justEvaluated = false;

  function compute(a, b, op) {
    a = parseFloat(a); b = parseFloat(b);
    switch (op) {
      case "+": return a + b;
      case "−": return a - b;
      case "×": return a * b;
      case "÷": return b === 0 ? null : a / b;
    }
  }

  function format(n) {
    if (n === null) return "Cannot divide by 0";
    return String(parseFloat(n.toPrecision(12)));
  }

  function render() {
    currentEl.textContent = current;
    historyEl.textContent = operator ? `${previous} ${operator}` : "";
  }

  function inputNumber(d) {
    if (justEvaluated) { current = "0"; justEvaluated = false; }
    if (isNaN(current)) current = "0";
    current = current === "0" ? d : current + d;
    if (current.length > 14) current = current.slice(0, 14);
    render();
  }

  function inputDot() {
    if (justEvaluated) { current = "0"; justEvaluated = false; }
    if (isNaN(current)) current = "0";
    if (!current.includes(".")) current += ".";
    render();
  }

  function chooseOperator(op) {
    if (isNaN(current)) return;
    if (operator && !justEvaluated) {
      const result = compute(previous, current, operator);
      if (result === null) { reset(); current = format(null); render(); return; }
      previous = format(result);
    } else {
      previous = current;
    }
    operator = op;
    current = "0";
    justEvaluated = false;
    render();
  }

  function equals() {
    if (!operator || isNaN(current)) return;
    const result = compute(previous, current, operator);
    historyEl.textContent = `${previous} ${operator} ${current} =`;
    operator = null;
    previous = null;
    current = format(result);
    justEvaluated = true;
    currentEl.textContent = current;
  }

  function reset() {
    current = "0"; previous = null; operator = null; justEvaluated = false;
  }

  function backspace() {
    if (justEvaluated || isNaN(current)) { reset(); }
    else { current = current.length > 1 ? current.slice(0, -1) : "0"; }
    render();
  }

  function percent() {
    if (isNaN(current)) return;
    current = format(parseFloat(current) / 100);
    render();
  }

  document.querySelector(".keys").addEventListener("click", (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    if (b.dataset.num !== undefined) inputNumber(b.dataset.num);
    else if (b.dataset.op) chooseOperator(b.dataset.op);
    else switch (b.dataset.action) {
      case "clear": reset(); render(); break;
      case "delete": backspace(); break;
      case "percent": percent(); break;
      case "dot": inputDot(); break;
      case "equals": equals(); break;
    }
  });

  // Keyboard support
  document.addEventListener("keydown", (e) => {
    if (e.key >= "0" && e.key <= "9") inputNumber(e.key);
    else if (e.key === ".") inputDot();
    else if (e.key === "+") chooseOperator("+");
    else if (e.key === "-") chooseOperator("−");
    else if (e.key === "*") chooseOperator("×");
    else if (e.key === "/") { e.preventDefault(); chooseOperator("÷"); }
    else if (e.key === "%") percent();
    else if (e.key === "Enter" || e.key === "=") { e.preventDefault(); equals(); }
    else if (e.key === "Backspace") backspace();
    else if (e.key === "Escape") { reset(); render(); }
  });

  render();
</script>
</body>
</html>
